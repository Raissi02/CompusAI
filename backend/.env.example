APP_ENV=development
DATABASE_URL=sqlite:///./smartcampus.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# Optional OpenAI-compatible chat and embedding service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional SMTP. Without this, notifications are recorded but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
